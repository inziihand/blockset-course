# VM host only. Bootstrap writes real values to a root-owned file outside Git.
STRATEXEC_VM_AGENT_HOST=127.0.0.1
STRATEXEC_VM_AGENT_PORT=8443
STRATEXEC_VM_AGENT_INSECURE_LOOPBACK=false
STRATEXEC_VM_AGENT_TLS_CERT_PATH=/etc/stratexec/tls/server.crt
STRATEXEC_VM_AGENT_TLS_KEY_PATH=/etc/stratexec/tls/server.key
STRATEXEC_VM_AGENT_CLIENT_CA_PATH=/etc/stratexec/tls/client-ca.crt
STRATEXEC_VM_AGENT_TRUST_STORE=/etc/stratexec/vm-agent-trust.json
STRATEXEC_VM_AGENT_STATE_ROOT=/var/lib/stratexec/vm-agent
STRATEXEC_VM_AGENT_RUNTIME_MODE=docker
STRATEXEC_VM_AGENT_SAFETY_SNAPSHOT_PATH=/var/lib/stratexec/worker-safety.json
