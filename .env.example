# 通用母版範例。每個客戶／環境由 bootstrap-installation.ps1 產生自己的 .env.local。
# Firebase Web SDK 設定是公開的專案識別資訊，不是服務帳戶憑證。
# Vite 會把 VITE_* 提供給瀏覽器；Firebase Web 設定只用來識別專案，
# 並不是管理員憑證。
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 選填的 Firebase Web App metadata；Authentication 本身不需要這些欄位。
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_STRATEXEC_INSTALLATION_KEY=your-installation-key

# 選填的本機 Auth Emulator；使用正式 Firebase Auth 時保持空白。
# 範例：http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Identity API 使用的伺服器端初始管理員名單；正式安裝由 install.ps1 注入 runtime。
# 可填逗號分隔的標準化信箱。禁止改成 VITE_*；前端信箱比對不能授予管理權。
# 範例：admin@example.com,backup-admin@example.com
STRATEXEC_BOOTSTRAP_ADMIN_EMAILS=

# 本機 App 服務與 Deployment Agent 查驗 App entitlement 的 Identity API。
STRATEXEC_IDENTITY_BASE_URL=http://127.0.0.1:8180

# 本機 App Package Agent；它會修改目前 repository，永遠只綁定 loopback。
STRATEXEC_APP_PACKAGE_AGENT_HOST=127.0.0.1
STRATEXEC_APP_PACKAGE_AGENT_PORT=8182
# 未簽章套件預設只能預檢。只有受信任的本機開發環境才明確改成 true。
STRATEXEC_ALLOW_UNSIGNED_APP_PACKAGES=false

# 本機 Deployment Agent；秘密寫入與 Cloud target 預設停用。正式執行環境必須使用 attached service account 或 Workload Identity。
STRATEXEC_DEPLOYMENT_AGENT_HOST=127.0.0.1
STRATEXEC_DEPLOYMENT_AGENT_PORT=8183
STRATEXEC_SECRET_MANAGER_MODE=disabled
STRATEXEC_DEPLOYMENT_TARGET_MODE=disabled

# 第 10 批 VM Docker driver（只有在 STRATEXEC_DEPLOYMENT_TARGET_MODE=gcp-vm-docker 時需要）。
# 皆為 Deployment Agent 主機上的外部檔案路徑；不得提交私鑰、憑證或秘密值。
STRATEXEC_VM_DESIRED_STATE_KEY_ID=
STRATEXEC_VM_DESIRED_STATE_PRIVATE_KEY_PATH=
STRATEXEC_VM_AGENT_CLIENT_CERT_PATH=
STRATEXEC_VM_AGENT_CLIENT_KEY_PATH=
STRATEXEC_VM_AGENT_CA_PATH=
