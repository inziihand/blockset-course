{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratexec.local/schemas/app-manifest.schema.json",
  "title": "StratExec installable App manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appKey",
    "version",
    "platformCompatibility",
    "kind",
    "displayName",
    "source",
    "routes",
    "requiredServices",
    "access",
    "lifecycle",
    "package",
    "deploymentDocument"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "platformCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "appContractVersion"],
      "properties": {
        "minimumVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "appContractVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "kind": { "enum": ["platform", "frontend-app"] },
    "displayName": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "requiredServices": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMode", "allowedModes", "adminAllowed", "protected"],
      "properties": {
        "defaultMode": {
          "enum": ["public", "all_members", "grant_required", "admins_only", "disabled"]
        },
        "allowedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["public", "all_members", "grant_required", "admins_only", "disabled"] }
        },
        "entitlements": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "displayName"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
              "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
              "description": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "adminAllowed": { "type": "boolean" },
        "protected": { "type": "boolean" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "removable", "defaultStatus"],
      "properties": {
        "category": { "enum": ["core", "sample", "application"] },
        "removable": { "type": "boolean" },
        "defaultStatus": { "enum": ["installed", "uninstalled"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installable", "ownerApp"],
      "properties": {
        "installable": { "type": "boolean" },
        "ownerApp": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "deploymentDocument": {
      "type": "string",
      "pattern": "^apps/console/src/(shell|apps/[a-z][a-z0-9-]*)/DEPLOYMENT\\.md$"
    },
    "deploymentManifest": {
      "type": "string",
      "pattern": "^infrastructure/app-deployments/[a-z][a-z0-9-]*\\.json$"
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryModule", "title", "subtitle", "description", "icon", "status", "displayMode", "order"],
      "properties": {
        "entryModule": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.tsx$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "status": { "enum": ["enabled", "preview", "planned"] },
        "displayMode": { "enum": ["compact", "responsive"] },
        "headerLayout": { "enum": ["standard", "merged"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "frontend-app" } } },
      "then": { "required": ["frontend"] },
      "else": { "not": { "required": ["frontend"] } }
    },
    {
      "if": {
        "properties": {
          "package": {
            "properties": { "installable": { "const": true } },
            "required": ["installable"]
          }
        }
      },
      "then": { "required": ["deploymentManifest"] }
    }
  ]
}
