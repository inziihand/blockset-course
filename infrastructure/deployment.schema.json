{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratexec.local/schemas/deployment.schema.json",
  "title": "StratExec service deployment recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadClass",
    "artifact",
    "recommendedTarget",
    "allowedTargets",
    "stateful",
    "continuous",
    "listen",
    "intendedExposure",
    "productionReadiness",
    "blockers"
  ],
  "allOf": [
    {
      "if": { "properties": { "workloadClass": { "const": "request-http" } } },
      "then": { "required": ["cloudRun"] }
    },
    {
      "if": { "properties": { "workloadClass": { "const": "continuous-worker" } } },
      "then": { "required": ["vmDocker"] }
    }
  ],
  "properties": {
    "workloadClass": {
      "enum": ["static-web", "request-http", "event-handler", "batch-job", "continuous-worker"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "context", "dockerfile"],
      "properties": {
        "type": { "const": "oci" },
        "context": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
        "dockerfile": { "type": "string", "pattern": "(^|/)Dockerfile$" }
      }
    },
    "recommendedTarget": {
      "enum": ["firebase-hosting", "firebase-functions-v2", "cloud-run-service", "cloud-run-job", "cloud-run-worker-pool", "vm-docker"]
    },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["firebase-hosting", "firebase-functions-v2", "cloud-run-service", "cloud-run-job", "cloud-run-worker-pool", "vm-docker"]
      }
    },
    "stateful": { "type": "boolean" },
    "continuous": { "type": "boolean" },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "portEnvironment", "healthPath", "readinessPath"],
      "properties": {
        "host": { "const": "0.0.0.0" },
        "portEnvironment": { "const": "PORT" },
        "healthPath": { "type": "string", "pattern": "^/" },
        "readinessPath": { "type": "string", "pattern": "^/" }
      }
    },
    "cloudRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress", "iamInvocation", "cpu", "memory", "timeoutSeconds", "concurrency", "minInstances", "maxInstances", "serviceAccountRoles", "environment", "secrets"],
      "properties": {
        "ingress": { "enum": ["all", "internal-and-cloud-load-balancing", "internal"] },
        "iamInvocation": { "enum": ["public-app-auth", "cloud-iam"] },
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "minInstances": { "type": "integer", "minimum": 0 },
        "maxInstances": { "type": "integer", "minimum": 1 },
        "serviceAccountRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^roles/[a-zA-Z0-9.]+$" }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "source": { "enum": ["project-id", "service-url", "operator-input"] },
              "serviceKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "input": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "type", "required", "impact"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["string", "integer", "boolean", "select"] },
                  "required": { "type": "boolean" },
                  "impact": { "enum": ["normal", "high"] },
                  "description": { "type": "string", "minLength": 1 },
                  "default": {},
                  "minimum": { "type": "integer" },
                  "maximum": { "type": "integer" },
                  "minLength": { "type": "integer", "minimum": 0 },
                  "maxLength": { "type": "integer", "minimum": 1 },
                  "pattern": { "type": "string" },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["value", "label"],
                      "properties": {
                        "value": { "type": "string" },
                        "label": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            },
            "allOf": [{
              "if": { "properties": { "source": { "const": "operator-input" } } },
              "then": { "required": ["input"] },
              "else": { "not": { "required": ["input"] } }
            }]
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environment", "secretName", "source", "temporary"],
            "properties": {
              "environment": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "secretName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "source": { "const": "bootstrap-admin-emails" },
              "temporary": { "type": "boolean" }
            }
          }
        }
      }
    },
    "vmDocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentTransport", "desiredStateSignature", "immutableImage", "hostLocalAccountLock", "persistentData", "environment", "secrets", "preflight", "rollback"],
      "properties": {
        "agentTransport": { "const": "mtls" },
        "desiredStateSignature": { "const": "Ed25519" },
        "immutableImage": { "const": true },
        "hostLocalAccountLock": { "const": true },
        "persistentData": { "const": true },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "source": { "enum": ["project-id", "service-url", "operator-input"] },
              "serviceKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "input": { "type": "object" }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environment", "secretName", "temporary"],
            "properties": {
              "environment": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "secretName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "temporary": { "type": "boolean" }
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountUniqueness", "ordersAndPositions", "sqliteSchema", "backup", "diskSpace", "reconciliation"],
          "properties": {
            "accountUniqueness": { "const": true },
            "ordersAndPositions": { "const": true },
            "sqliteSchema": { "const": true },
            "backup": { "const": true },
            "diskSpace": { "const": true },
            "reconciliation": { "const": true }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previousImmutableImage", "preserveData"],
          "properties": {
            "previousImmutableImage": { "const": true },
            "preserveData": { "const": true }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unauthenticatedRequests"],
      "properties": {
        "unauthenticatedRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "expectedStatus"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/api/" },
              "expectedStatus": { "type": "integer", "minimum": 400, "maximum": 499 }
            }
          }
        },
        "authenticatedRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "expectedStatus", "audience"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/api/" },
              "expectedStatus": { "type": "integer", "minimum": 200, "maximum": 499 },
              "audience": { "enum": ["active-member", "administrator"] }
            }
          }
        }
      }
    },
    "intendedExposure": { "enum": ["public-demo", "authenticated", "internal"] },
    "productionReadiness": { "enum": ["blocked", "candidate", "ready"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
